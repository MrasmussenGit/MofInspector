<Window x:Class="MofInspector.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MOF Comparison"
        Height="650" Width="1080" 
        Background="{StaticResource BackgroundLightBrush}" 
        WindowStartupLocation="CenterOwner"
        MinWidth="1080">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Controls -->
            <RowDefinition Height="*"/>
            <!-- List -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Top section: file load + paths (row 0) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Button Content="Load File 1" Width="120" Margin="0,0,8,0" Click="LoadFile1_Click"/>
                <Button Content="Load File 2" Width="120" Margin="0,0,16,0" Click="LoadFile2_Click"/>
                <TextBlock Text="File1:" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="File1PathText" Width="240" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock Text="File2:" FontWeight="Bold" Margin="15,0,5,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="File2PathText" Width="240" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>

        <!-- File Load Section -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Load File 1" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Width="120" Height="32"
                            Margin="0,0,8,0" 
                            Click="LoadFile1_Click"/>
                    <Button Content="Load File 2" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Width="120" Height="32"
                            Margin="0,0,16,0" 
                            Click="LoadFile2_Click"/>
                    <TextBlock Text="File 1:" 
                               Style="{StaticResource LabelTextStyle}" 
                               Margin="0,0,5,0" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="File1PathText" 
                               Style="{StaticResource BodyTextStyle}"
                               Width="240" 
                               TextTrimming="CharacterEllipsis" 
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock Text="File 2:" 
                               Style="{StaticResource LabelTextStyle}" 
                               Margin="15,0,5,0" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="File2PathText" 
                               Style="{StaticResource BodyTextStyle}"
                               Width="240" 
                               TextTrimming="CharacterEllipsis" 
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Show:" 
                               Style="{StaticResource LabelTextStyle}" 
                               Margin="0,0,8,0" 
                               VerticalAlignment="Center"/>
                    <CheckBox x:Name="ShowAllFiltersCheckBox"
                              Content="All"
                              ToolTip="Toggle every filter on or off."
                              IsChecked="False"
                              Margin="0,0,16,0"
                              Checked="MasterFiltersChanged"
                              Unchecked="MasterFiltersChanged"/>
                    <CheckBox x:Name="ShowMatchCheckBox"
                              Content="Match"
                              ToolTip="Rules present in both files with all properties identical."
                              IsChecked="False"
                              Margin="0,0,8,0"
                              Checked="FilterDiffsChanged"
                              Unchecked="FilterDiffsChanged"/>
                    <CheckBox x:Name="ShowDifferentCheckBox"
                              Content="Different"
                              ToolTip="Rules in both files where at least one non-version property differs."
                              IsChecked="True"
                              Margin="0,0,8,0"
                              Checked="FilterDiffsChanged"
                              Unchecked="FilterDiffsChanged"/>
                <CheckBox x:Name="ShowVersionOnlyCheckBox"
                          Content="Version Only"
                          ToolTip="Rules differing only by PowerSTIG version/path; all other properties match."
                          IsChecked="False"
                          Margin="0,0,8,0"
                          Checked="FilterDiffsChanged"
                          Unchecked="FilterDiffsChanged"/>
                    <CheckBox x:Name="ShowMissingFile1CheckBox"
                              Content="Missing in File 1"
                              ToolTip="Rule absent from File 1 but present in File 2."
                              IsChecked="True"
                              Margin="0,0,8,0"
                              Checked="FilterDiffsChanged"
                              Unchecked="FilterDiffsChanged"/>
                    <CheckBox x:Name="ShowMissingFile2CheckBox"
                              Content="Missing in File 2"
                              ToolTip="Rule absent from File 2 but present in File 1."
                              IsChecked="True"
                              Margin="0,0,8,0"
                              Checked="FilterDiffsChanged"
                              Unchecked="FilterDiffsChanged"/>
                    <CheckBox x:Name="ShowParsingErrorCheckBox"
                              Content="Parsing Error"
                              ToolTip="Rule found but its details could not be parsed in one or both files."
                              IsChecked="False"
                              Margin="0,0,8,0"
                              Checked="FilterDiffsChanged"
                              Unchecked="FilterDiffsChanged"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Data Grid -->
        <ListView x:Name="DifferencesList"
                  Grid.Row="2"
                  Background="White"
                  MouseDoubleClick="DifferencesList_MouseDoubleClick"
                  KeyDown="DifferencesList_KeyDown"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="4"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Match">
                            <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="VersionOnly">
                            <Setter Property="Background" Value="{StaticResource WarningLightBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Different">
                            <Setter Property="Background" Value="{StaticResource ErrorLightBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Missing in File 1">
                            <Setter Property="Background" Value="{StaticResource InfoLightBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Missing in File 2">
                            <Setter Property="Background" Value="{StaticResource InfoLightBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Parsing Error">
                            <Setter Property="Background" Value="#FFB266"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Rule ID" Width="230">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RuleId}" Style="{StaticResource BodyTextStyle}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Status" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyTextStyle}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Category" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Category}" Style="{StaticResource BodyTextStyle}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Details" Width="450">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Details}" Style="{StaticResource BodyTextStyle}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Bottom aligned stats + Close button -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Total Rules:" FontWeight="Bold" Margin="0,0,4,0"/>
                <TextBlock x:Name="TotalCountText" Margin="0,0,12,0"/>
                <TextBlock Text="Displayed:" FontWeight="Bold" Margin="0,0,4,0"/>
                <TextBlock x:Name="DisplayedCountText"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Close"
                    Width="100"
                    Height="30"
                    Margin="12,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>