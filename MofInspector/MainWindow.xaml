<Window x:Class="MofInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MOF Inspector"
        Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="MOF Inspector" 
                   FontSize="32" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,20,0,20"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center">
            <Button Content="Inspect MOF" 
                    Width="250" 
                    Height="50" 
                    FontSize="16" 
                    Margin="0,10" 
                    Click="InspectMof_Click"/>
            <Button Content="Compare MOF Files" 
                    Width="250" 
                    Height="50" 
                    FontSize="16" 
                    Margin="0,10" 
                    Click="Compare_Click"/>
            <Button Content="Exit" 
                    Width="250" 
                    Height="50" 
                    FontSize="16" 
                    Margin="0,10" 
                    Click="Exit_Click"/>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Select an option to continue" 
                       HorizontalAlignment="Center" 
                       Foreground="Gray"/>
            <TextBlock x:Name="VersionText"
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Center"
                       Margin="0,0,15,0"
                       FontSize="11"
                       Foreground="#95A5A6"
                       FontStyle="Italic"/>
        </Grid>
    </Grid>
</Window>
