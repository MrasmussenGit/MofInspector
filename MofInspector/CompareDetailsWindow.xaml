<Window x:Class="MofInspector.CompareDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rule Comparison Details"
        Height="950" Width="1400"
        Background="{StaticResource BackgroundLightBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DataTemplate x:Key="RawLineTemplate">
            <TextBlock Text="{Binding Text}" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"/>
        </DataTemplate>
        <Style x:Key="PropertyDiffItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="{Binding Status}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFCCE5FF"/>
                </Trigger>
                <DataTrigger Binding="{Binding Status}" Value="Same">
                    <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Match">
                    <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="VersionOnly">
                    <Setter Property="Background" Value="{StaticResource WarningLightBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Different">
                    <Setter Property="Background" Value="{StaticResource ErrorLightBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Missing in File 1">
                    <Setter Property="Background" Value="{StaticResource InfoLightBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Missing in File 2">
                    <Setter Property="Background" Value="{StaticResource InfoLightBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Parsing Error">
                    <Setter Property="Background" Value="{StaticResource ErrorMediumBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Info">
                    <Setter Property="Background" Value="#F0F2F5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Rule ID:" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="RuleIdText" Margin="6,0,20,0" FontFamily="Consolas" VerticalAlignment="Center"/>
            <TextBlock Text="Overall Status:" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="OverallStatusText" Margin="6,0,20,0" FontWeight="Bold" VerticalAlignment="Center"/>
            <!-- Close button moved to bottom right -->
        </StackPanel>

        <GroupBox Header="Property Differences" Grid.Row="1" Margin="0,0,0,8">
            <ListView x:Name="PropertyDiffList"
                      ItemContainerStyle="{StaticResource PropertyDiffItemStyle}"
                      SelectionMode="Extended"
                      KeyDown="PropertyDiffList_KeyDown"
                      GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Property" Width="180" DisplayMemberBinding="{Binding Key}"/>
                        <GridViewColumn Header="File 1 Value" Width="250" DisplayMemberBinding="{Binding Value1}"/>
                        <GridViewColumn Header="File 2 Value" Width="250" DisplayMemberBinding="{Binding Value2}"/>
                        <GridViewColumn Header="Status" Width="130" DisplayMemberBinding="{Binding Status}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <Border Grid.Row="2" Padding="6" Background="#E9EEF5" CornerRadius="4" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ShowRawDiffCheckBox"
                          Content="Show Raw Text Diff"
                          Margin="0,0,12,0"
                          Checked="ShowRawDiffChanged"
                          Unchecked="ShowRawDiffChanged"/>
                <CheckBox x:Name="ShowOnlyChangedLinesCheckBox"
                          Content="Only Changed Lines"
                          Checked="ShowOnlyChangedLinesChanged"
                          Unchecked="ShowOnlyChangedLinesChanged"/>
            </StackPanel>
        </Border>

        <!-- Property Differences Section -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Margin="15,15,15,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,5">
                    <TextBlock Text="Property Differences" 
                               Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="💡 Double-click a row to view full details" 
                               Style="{StaticResource HintTextStyle}"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>
                </StackPanel>

                <ListView Grid.Row="1"
                          x:Name="PropertyDiffList"
                          ItemContainerStyle="{StaticResource PropertyDiffItemStyle}"
                          SelectionMode="Extended"
                          KeyDown="PropertyDiffList_KeyDown"
                          MouseDoubleClick="PropertyDiffList_MouseDoubleClick"
                          GridViewColumnHeader.Click="GridViewColumnHeader_Click"
                          BorderThickness="0"
                          MinHeight="150"
                          MaxHeight="250"
                          Margin="10,0,10,10">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Property" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Key, Mode=OneWay}" 
                                                 IsReadOnly="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontWeight="SemiBold"
                                                 FontSize="13"
                                                 TextWrapping="Wrap"
                                                 IsReadOnlyCaretVisible="True"
                                                 Cursor="IBeam"
                                                 ToolTip="{Binding Key}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="File 1 Value" Width="320">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value1, Mode=OneWay}" 
                                                 IsReadOnly="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="12"
                                                 TextWrapping="Wrap"
                                                 IsReadOnlyCaretVisible="True"
                                                 Cursor="IBeam"
                                                 VerticalScrollBarVisibility="Auto"
                                                 ToolTip="{Binding Value1}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="File 2 Value" Width="320">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value2, Mode=OneWay}" 
                                                 IsReadOnly="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="12"
                                                 TextWrapping="Wrap"
                                                 IsReadOnlyCaretVisible="True"
                                                 Cursor="IBeam"
                                                 VerticalScrollBarVisibility="Auto"
                                                 ToolTip="{Binding Value2}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Status" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Status, Mode=OneWay}" 
                                                 IsReadOnly="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontWeight="SemiBold"
                                                 FontSize="12"
                                                 IsReadOnlyCaretVisible="True"
                                                 Cursor="IBeam"
                                                 ToolTip="{Binding Status}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Detail Expander - Shows full content of selected property -->
                <Expander Grid.Row="2" 
                          x:Name="PropertyDetailExpander"
                          IsExpanded="False"
                          Header="Property Detail View"
                          Margin="10,0,10,10"
                          BorderBrush="#BDC3C7"
                          BorderThickness="1"
                          Background="White">
                    <Border Background="#F8F9FA" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Property Name -->
                            <TextBlock Grid.Row="0" 
                                       x:Name="DetailPropertyName"
                                       Text="Property: (Select a property above)"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,10"/>

                            <!-- File 1 Value -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                                <TextBlock Text="File 1 Value:" 
                                           FontWeight="SemiBold"
                                           Foreground="#34495E"
                                           Margin="0,0,0,5"/>
                                <Border Background="White" 
                                        BorderBrush="#BDC3C7" 
                                        BorderThickness="1" 
                                        CornerRadius="3" 
                                        Padding="10"
                                        MaxHeight="250">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="DetailValue1"
                                                 Text="(No selection)"
                                                 IsReadOnly="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas"
                                                 FontSize="11"
                                                 IsReadOnlyCaretVisible="True"
                                                 Cursor="IBeam"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <!-- File 2 Value -->
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="File 2 Value:" 
                                           FontWeight="SemiBold"
                                           Foreground="#34495E"
                                           Margin="0,0,0,5"/>
                                <Border Background="White" 
                                        BorderBrush="#BDC3C7" 
                                        BorderThickness="1" 
                                        CornerRadius="3" 
                                        Padding="10"
                                        MaxHeight="250">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="DetailValue2"
                                                 Text="(No selection)"
                                                 IsReadOnly="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas"
                                                 FontSize="11"
                                                 IsReadOnlyCaretVisible="True"
                                                 Cursor="IBeam"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>
            </Grid>
        </Border>

        <!-- Raw Text Diff Section -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Margin="15,0,15,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                    <TextBlock Text="Raw Text Diff" 
                               Style="{StaticResource SectionTitleStyle}" 
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <CheckBox x:Name="ShowRawDiffCheckBox"
                              Content="Show Diff"
                              IsChecked="True"
                              Margin="0,0,15,0"
                              VerticalAlignment="Center"
                              Checked="ShowRawDiffChanged"
                              Unchecked="ShowRawDiffChanged"/>
                    <CheckBox x:Name="ShowOnlyChangedLinesCheckBox"
                              Content="Only Changed Lines"
                              VerticalAlignment="Center"
                              Checked="ShowOnlyChangedLinesChanged"
                              Unchecked="ShowOnlyChangedLinesChanged"/>
                </StackPanel>

                <Border Grid.Row="1" 
                        Background="#ECF0F1" 
                        Padding="10,6" 
                        BorderBrush="#BDC3C7" 
                        BorderThickness="0,1,0,1"
                        Margin="0,5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="File 1" 
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#34495E"/>
                        <TextBlock Grid.Column="2" 
                                   Text="File 2" 
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#34495E"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                            BorderBrush="#BDC3C7" 
                            BorderThickness="1"
                            Background="White">
                        <ListBox x:Name="RawLines1"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 SelectionMode="Extended"
                                 KeyDown="RawLines_KeyDown"
                                 ItemTemplate="{StaticResource RawLineTemplate}"
                                 BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="{Binding Bg}"/>
                                    <Setter Property="ToolTip" Value="{Binding Text}"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <GridSplitter Grid.Column="1"
                                  Width="5"
                                  HorizontalAlignment="Stretch"
                                  Background="#BDC3C7"/>

                    <Border Grid.Column="2" 
                            BorderBrush="#BDC3C7" 
                            BorderThickness="1"
                            Background="White">
                        <ListBox x:Name="RawLines2"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 SelectionMode="Extended"
                                 KeyDown="RawLines_KeyDown"
                                 ItemTemplate="{StaticResource RawLineTemplate}"
                                 BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="{Binding Bg}"/>
                                    <Setter Property="ToolTip" Value="{Binding Text}"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Style="{StaticResource FooterBorderStyle}">
            <Grid Margin="15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="💡 Tip: Right-click raw lists for copy options. Ctrl+C copies selected lines." 
                           Style="{StaticResource HintTextStyle}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Close"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="100"
                        Height="35"
                        Click="Close_Click"/>
            </Grid>
        </GroupBox>

        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock Text="Right-click raw lists for copy options. Ctrl+C copies selected lines." Foreground="#555"/>
        </DockPanel>

        <!-- Bottom row with Close button -->
        <Grid Grid.Row="6" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1"
                    Content="Close"
                    Padding="18,6"
                    Margin="12,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>