<Window x:Class="MofInspector.InspectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MOF Inspection" 
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <StackPanel>
                <TextBlock x:Name="MofFileNameText" 
                           Text="MOF File" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="White"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock x:Name="FilePathText" 
                               Text="Path: " 
                               FontSize="14"
                               Foreground="White" 
                               Margin="0,0,20,0"/>
                    <TextBlock x:Name="TotalRulesText" 
                               Text="Total Rules: " 
                               FontSize="14"
                               Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- STIG Summary -->
        <Border Grid.Row="1" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="12" Background="#ECF0F1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StigSummaryText" 
                           Text="STIGs: 0" 
                           FontSize="16" 
                           FontWeight="SemiBold"/>
                <TextBlock Text="💡 Tip: Double-click to view details | Ctrl+Click to select multiple | Use 'View All Rules' to see everything" 
                           FontSize="13" 
                           FontStyle="Italic"
                           Foreground="#7F8C8D"
                           VerticalAlignment="Center"
                           Margin="30,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- STIGs List -->
        <DataGrid Grid.Row="2" 
                  x:Name="StigsDataGrid"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  AlternatingRowBackground="#F8F9FA"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="True"
                  SelectionChanged="StigsDataGrid_SelectionChanged"
                  MouseDoubleClick="StigsDataGrid_MouseDoubleClick"
                  FontSize="14"
                  RowHeight="32">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="Background" Value="#34495E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="STIG / Product / DSC Resource" Binding="{Binding StigName}" Width="*" MinWidth="300">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Total Rules" Binding="{Binding TotalRules}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Skipped Rules" Binding="{Binding SkippedRules}" Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Active Rules" Binding="{Binding ActiveRules}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="15">
            <Button x:Name="ViewAllRulesButton" 
                    Content="View All Rules" 
                    Width="140" 
                    Height="40" 
                    FontSize="14"
                    Margin="0,0,10,0"
                    Click="ViewAllRulesButton_Click"/>
            <Button x:Name="ViewDetailsButton" 
                    Content="View Selected" 
                    Width="140" 
                    Height="40" 
                    FontSize="14"
                    Margin="0,0,10,0"
                    Click="ViewDetailsButton_Click"
                    IsEnabled="False"/>
            <Button x:Name="CloseButton" 
                    Content="Close" 
                    Width="120" 
                    Height="40"
                    FontSize="14"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>